# Platform-specific domain join usernames derived from the single
# workload_domain_bootstrap_username credential value.

workload_domain_bootstrap_windows_username: >-
  {{
    workload_domain_bootstrap_username
    if '@' in workload_domain_bootstrap_username
    else workload_domain_bootstrap_username
         ~ '@'
         ~ workload_domain_bootstrap_domain_name
  }}

workload_domain_bootstrap_linux_username: >-
  {{
    workload_domain_bootstrap_username.split('@')[0]
  }}
