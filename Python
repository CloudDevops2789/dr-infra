- name: Check Python runtimes
  ansible.builtin.shell: |
    echo "PATH=$PATH"
    echo "which python3:"
    which python3 || true

    echo "python3 version:"
    python3 --version || true

    echo "python3 executable:"
    python3 -c 'import sys; print(sys.executable)' || true

    echo "boto3 from python3:"
    python3 -c 'import boto3; print(boto3.__version__); print(boto3.__file__)' || true

    echo "Ansible playbook Python:"
    echo "{{ ansible_playbook_python }}"

    echo "boto3 from Ansible Python:"
    "{{ ansible_playbook_python }}" -c \
      'import boto3,sys; print(sys.executable); print(boto3.__version__); print(boto3.__file__)' || true
  changed_when: false
